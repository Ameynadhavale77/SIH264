# Sample environment — copy to .env and fill in values

PORT=5001
NODE_ENV=production

# SQLite (default – works on Render free tier)
DATABASE_URL="file:./prisma/prod.db"

# OR switch to PostgreSQL (e.g. Neon free tier):
# DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"

# JWT Secret — change this to a long random string in production
JWT_SECRET=change_me_to_a_long_random_secret

# Frontend URL for CORS (set to your Vercel URL after deploy)
FRONTEND_URL=https://your-app.vercel.app
